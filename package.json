{
  "name": "familios-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FamiliOS — Personal agent teams for family life and household admin.",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "node --test \"server/test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "generate-icons": "node mobile-version/setup-icons.mjs",
    "install-browser": "playwright install chromium",
    "postinstall": "node scripts/postinstall-browser.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lucide-react": "^0.456.0",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  }
}
