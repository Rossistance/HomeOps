# HomeOps deployment configuration.
# Copy this file to ".env" (same folder) and fill in values, then restart the app.
#   PowerShell:  Copy-Item .env.example .env
# Lines starting with # are comments. Do NOT wrap values in quotes unless they
# contain spaces. The backend loads this file automatically on startup.
# NEVER commit a real .env — it contains secrets.

# ---------------------------------------------------------------------------
# Where the app is served from (used to build the OAuth redirect + allowed origin).
# For local dev, leave these as-is and open the app at http://localhost:5173
# ---------------------------------------------------------------------------
HOMEOPS_PUBLIC_URL=https://homeops-ai.onrender.com/
# HOMEOPS_ALLOWED_ORIGINS=https://homeops-ai.onrender.com/,http://localhost:5173,http://127.0.0.1:5173,http://192.168.4.24:8787,http://192.168.4.24:9081

# ---------------------------------------------------------------------------
# Google (Gmail, Calendar, Drive)
# In Google Cloud Console → APIs & Services → Credentials → Create credentials →
# "OAuth client ID" → Application type: "Web application".
# Add this EXACT Authorized redirect URI:
#     http://localhost:8787/api/oauth/callback
# After you click Create, the dialog shows BOTH the Client ID and the Client secret.
# ---------------------------------------------------------------------------
HOMEOPS_OAUTH_GOOGLE_CLIENT_ID=
HOMEOPS_OAUTH_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional — other OAuth providers (leave blank to keep them "Not configured").
# Each one's Authorized redirect URI is also: http://localhost:8787/api/oauth/callback
# ---------------------------------------------------------------------------
HOMEOPS_OAUTH_MICROSOFT_CLIENT_ID=
HOMEOPS_OAUTH_MICROSOFT_CLIENT_SECRET=
HOMEOPS_OAUTH_SLACK_CLIENT_ID=
HOMEOPS_OAUTH_SLACK_CLIENT_SECRET=
HOMEOPS_OAUTH_DROPBOX_CLIENT_ID=
HOMEOPS_OAUTH_DROPBOX_CLIENT_SECRET=
HOMEOPS_OAUTH_NOTION_CLIENT_ID=
HOMEOPS_OAUTH_NOTION_CLIENT_SECRET=
HOMEOPS_OAUTH_TODOIST_CLIENT_ID=
HOMEOPS_OAUTH_TODOIST_CLIENT_SECRET=
HOMEOPS_OAUTH_TICKTICK_CLIENT_ID=
HOMEOPS_OAUTH_TICKTICK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional — iMessage bridge (BlueBubbles Server on a cloud Mac).
# One Apple ID / phone number serves every household; inbound texts are routed by the
# sender's verified Phone/Text contact method (Settings → Contacts). The server password
# IS the API credential (BlueBubbles reads it from ?password=). Register the webhook in
# BlueBubbles Server as: POST <HOMEOPS_PUBLIC_URL>/api/webhooks/bluebubbles?secret=<secret>
# ---------------------------------------------------------------------------
# BLUEBUBBLES_URL=https://imessage.example.com
# BLUEBUBBLES_PASSWORD=
# BLUEBUBBLES_WEBHOOK_SECRET=
# BLUEBUBBLES_SEND_METHOD=private-api

# ---------------------------------------------------------------------------
# Optional — Browser Automation runtime (advanced; most people don't need this).
# A real Playwright headless-browser service ships in server/browser-runtime.
# To enable it:
#     cd server/browser-runtime && npm install && npm run setup && npm start
# then set the URL below and restart the app. Leaving it blank correctly shows
# "Runtime not connected" (the connector's tools refuse to run — no fakery).
# ---------------------------------------------------------------------------
# BROWSER_RUNTIME_URL=http://localhost:9223
