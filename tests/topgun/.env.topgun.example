# Top Gun harness environment — copy to tests/topgun/.env.topgun and fill in.
# .env.topgun is gitignored. Never commit real credentials.
# Load automatically: the appium runner reads this file; Playwright lanes read the
# process env (start them via `node --env-file-if-exists=tests/topgun/.env.topgun ...`
# or export the vars in your shell).

# ── BrowserStack App Automate (primary iOS device cloud) ─────────────────────
# Account → https://www.browserstack.com/app-automate (Settings → Access keys)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# Set by tests/topgun/appium/upload-browserstack.mjs after uploading the .ipa (bs://…)
BROWSERSTACK_APP_ID=

# ── LambdaTest (alternate iOS device cloud) ──────────────────────────────────
LT_USERNAME=
LT_ACCESS_KEY=
LT_APP_ID=

# ── Generic Appium 2 endpoint (escape hatch / future local Mac) ──────────────
# e.g. http://127.0.0.1:4723/  — used by caps/generic.ios.json
APPIUM_REMOTE_URL=
APPIUM_APP=

# ── Appetize.io (browser-hosted iOS simulator) ───────────────────────────────
# Account → https://appetize.io → account page → API token
APPETIZE_API_TOKEN=
# Set by tests/topgun/appetize/upload-appetize.mjs after the first upload
APPETIZE_PUBLIC_KEY=

# ── Test behavior knobs ──────────────────────────────────────────────────────
# Which caps file the appium lane uses by default: browserstack | lambdatest | generic
TOPGUN_CAPS=browserstack
# Profile the iOS smoke signs in as — use a real member of the backend the BUILD talks
# to (the baked EXPO_PUBLIC_API_URL backend, i.e. your live household). Child/guest
# profiles need no PIN, even in prod. Seed names like "Elaine Brooks" exist only on
# fresh/dev backends. Unset → the smoke taps the first profile card.
TOPGUN_IOS_PROFILE=
# Web-lane counterpart (unset → first non-PIN profile from /api/profiles)
TOPGUN_WEB_PROFILE=
# Owner PIN for PIN-gated owner flows on the PRODUCTION backend (leave empty to skip those specs)
TOPGUN_IOS_PIN=
# Web owner PIN — only needed when the web lane targets a production-mode backend
TOPGUN_WEB_PIN=
# Allow mutating iOS cloud specs (create/edit data). Requires a disposable backend/tenant.
TOPGUN_ALLOW_MUTATIONS=
# PWA spec surface: a PRODUCTION build origin, e.g. http://localhost:4173 after
# `npm run build && npm run preview`, or https://homeops-ai.onrender.com (read-only checks)
TOPGUN_PWA_BASEURL=
